# Skopiuj ten plik jako .env i uzupełnij wartościami z Firebase Console
# Firebase — projekt CRM Antyramy
VITE_FIREBASE_API_KEY=WPISZ_TUTAJ
VITE_FIREBASE_AUTH_DOMAIN=WPISZ_TUTAJ
VITE_FIREBASE_PROJECT_ID=WPISZ_TUTAJ
VITE_FIREBASE_STORAGE_BUCKET=WPISZ_TUTAJ
VITE_FIREBASE_MESSAGING_SENDER_ID=WPISZ_TUTAJ
VITE_FIREBASE_APP_ID=WPISZ_TUTAJ

# Adres backendu
# Lokalnie: http://localhost:4000
# Produkcja: https://crm.antyramy.eu  (ta sama domena co frontend)
VITE_API_URL=http://localhost:4000
