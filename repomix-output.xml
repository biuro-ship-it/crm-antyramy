<file path=".github/workflows/deploy.yml">
name: Deploy CRM Antyramy

on:
  push:
    branches: [main]

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repozytorium
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      # ── FRONTEND: build ────────────────────────────────────────────────────────
      - name: Zainstaluj zależności frontendu
        working-directory: frontend
        run: npm install

      - name: Zbuduj frontend
        working-directory: frontend
        env:
          VITE_FIREBASE_API_KEY: ${{ secrets.VITE_FIREBASE_API_KEY }}
          VITE_FIREBASE_AUTH_DOMAIN: ${{ secrets.VITE_FIREBASE_AUTH_DOMAIN }}
          VITE_FIREBASE_PROJECT_ID: ${{ secrets.VITE_FIREBASE_PROJECT_ID }}
          VITE_FIREBASE_STORAGE_BUCKET: ${{ secrets.VITE_FIREBASE_STORAGE_BUCKET }}
          VITE_FIREBASE_MESSAGING_SENDER_ID: ${{ secrets.VITE_FIREBASE_MESSAGING_SENDER_ID }}
          VITE_FIREBASE_APP_ID: ${{ secrets.VITE_FIREBASE_APP_ID }}
          VITE_API_URL: https://crm.antyramy.eu
        run: npm run build

      # ── BACKEND: build ─────────────────────────────────────────────────────────
      - name: Zainstaluj zależności backendu
        working-directory: backend
        run: npm install

      - name: Skompiluj backend TypeScript → JS
        working-directory: backend
        run: npm run build

      # ── KONFIGURACJA KLUCZA SSH ────────────────────────────────────────────────
      - name: Skonfiguruj klucz SSH
        run: |
          mkdir -p ~/.ssh
          echo "${{ secrets.SSH_PRIVATE_KEY }}" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          ssh-keyscan -H s61.mydevil.net >> ~/.ssh/known_hosts

      # ── DEPLOY: frontend → public_nodejs/public ────────────────────────────────
      - name: Wgraj frontend (React build) na serwer
        run: |
          rsync -avz --delete \
            -e "ssh -i ~/.ssh/deploy_key -o StrictHostKeyChecking=no" \
            frontend/dist/ \
            Pluszek@s61.mydevil.net:/usr/home/Pluszek/domains/crm.antyramy.eu/public_nodejs/public/

      # ── DEPLOY: backend dist/ ──────────────────────────────────────────────────
      - name: Wgraj backend dist/ na serwer
        run: |
          rsync -avz --delete \
            -e "ssh -i ~/.ssh/deploy_key -o StrictHostKeyChecking=no" \
            backend/dist/ \
            Pluszek@s61.mydevil.net:/usr/home/Pluszek/domains/crm.antyramy.eu/public_nodejs/dist/

      # ── DEPLOY: app.js + package.json ─────────────────────────────────────────
      - name: Wgraj app.js i package.json
        run: |
          scp -i ~/.ssh/deploy_key -o StrictHostKeyChecking=no \
            backend/app.js backend/package.json \
            Pluszek@s61.mydevil.net:/usr/home/Pluszek/domains/crm.antyramy.eu/public_nodejs/

      # ── npm install + restart ──────────────────────────────────────────────────
      - name: npm install i restart aplikacji
        run: |
          ssh -i ~/.ssh/deploy_key -o StrictHostKeyChecking=no \
            Pluszek@s61.mydevil.net << 'ENDSSH'
            cd /usr/home/Pluszek/domains/crm.antyramy.eu/public_nodejs
            npm20 install --production
            mkdir -p public/uploads
            devil www restart crm.antyramy.eu
            echo "✅ Deploy zakończony!"
          ENDSSH
</file>

