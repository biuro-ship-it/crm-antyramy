# Ścieżka do pliku serviceAccountKey.json (pobierz z Firebase Console)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Port serwera (domyślnie 4000)
PORT=4000

# URL frontendu (CORS)
FRONTEND_URL=https://crm.antyramy.eu

# Bazowy URL backendu (używany do zwracania URL zdjęć po uploadsie)
API_URL=https://api.crm.antyramy.eu

# Gmail API — wygeneruj tokenem: node scripts/get-gmail-token.js
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=biuro@antyramy.eu
