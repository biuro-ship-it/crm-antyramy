# Ścieżka do pliku serviceAccountKey.json (pobierz z Firebase Console)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Port serwera (domyślnie 4000)
PORT=4000

# URL frontendu (CORS)
FRONTEND_URL=https://crm.antyramy.eu

# Konta z dostepem do CRM — adresy po przecinku.
# Pominiecie zmiennej = biuro@antyramy.eu,krzysiekgodek@gmail.com
ALLOWED_EMAILS=biuro@antyramy.eu,krzysiekgodek@gmail.com

# Gmail API — wygeneruj tokenem: node scripts/get-gmail-token.js
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=biuro@antyramy.eu

# Fakturownia (tylko odczyt) — subdomena i token API
# Kod API: Ustawienia → Ustawienia konta → Integracja → Kod autoryzacyjny API
FAKTUROWNIA_DOMAIN=pluszek
FAKTUROWNIA_TOKEN=
